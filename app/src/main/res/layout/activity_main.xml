<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cloud_wisp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:background="@drawable/rounded_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.100000024">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"


            app:layout_constraintEnd_toEndOf="@id/display"
            app:layout_constraintTop_toTopOf="@id/display">

            <EditText
                android:id="@+id/calc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:autofillHints=""
                android:background="@drawable/edit_text_background"
                android:digits="0123456789+-*/%."
                android:fontFamily="@font/alexandria_medium"
                android:gravity="end"
                android:hint="@string/bt0"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:textColor="@color/cloud_wisp"
                android:textColorHint="@color/gray"
                android:textSize="90sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/operator"
            android:textSize="@dimen/textsize_60sp"
            android:fontFamily="@font/alexandria_medium"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="80dp"
            />

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/display"
            app:layout_constraintEnd_toEndOf="@id/display"
            >
            <TextView
                android:id="@+id/res"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/alexandria_medium"
                android:hint="@string/bt0"
                android:singleLine="true"
                android:textColor="@color/cloud_wisp"
                android:textColorHint="@color/gray"
                android:textSize="60sp"
                app:layout_constraintBottom_toBottomOf="@id/display"
                app:layout_constraintEnd_toEndOf="@id/display"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent" />
        </HorizontalScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:columnCount="4"
        android:rowCount="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/display">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_10dp"
            app:cardCornerRadius="@dimen/button_corner_radius_20dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/percent"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@color/dark"
                android:fontFamily="@font/alexandria_medium"
                android:text="@string/per"
                android:textColor="@color/cloud_wisp"
                android:textSize="30sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_10dp"
            app:cardCornerRadius="@dimen/button_corner_radius_20dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/fact"
                android:layout_width="@dimen/button_width_80dp"
                android:layout_height="@dimen/button_height_80dp"
                android:background="@color/dark"
                android:fontFamily="@font/alexandria_medium"
                android:text="@string/fact"
                android:textColor="@color/cloud_wisp"
                android:textSize="30sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_10dp"
            app:cardCornerRadius="@dimen/button_corner_radius_20dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/ac"
                android:layout_width="@dimen/button_height_80dp"
                android:layout_height="@dimen/button_height_80dp"
                android:background="@color/dark"
                android:fontFamily="@font/alexandria_medium"
                android:text="@string/ac"
                android:textColor="@color/cloud_wisp"
                android:textSize="30sp" />
        </androidx.cardview.widget.CardView>

        <!--        <androidx.appcompat.widget.AppCompatButton-->
        <!--            android:id="@+id/space"-->
        <!--            android:layout_width="80dp"-->
        <!--            android:layout_height="80dp"-->
        <!--            android:layout_margin="10dp"-->
        <!--            android:background="@drawable/rounded_button"-->
        <!--            android:fontFamily="@font/alexandria_medium"-->
        <!--            android:text="@string/space"-->
        <!--            android:textColor="@color/cloud_wisp"-->
        <!--            android:textSize="30sp" />-->

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_10dp"
            app:cardCornerRadius="@dimen/button_corner_radius_20dp">

            <ImageButton
