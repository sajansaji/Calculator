            app:cardCornerRadius="@dimen/button_corner_radius_20dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/division"
                android:layout_width="@dimen/button_width_80dp"
                android:layout_height="@dimen/button_height_80dp"
                android:background="@color/dark"
                android:fontFamily="@font/alexandria_medium"
                android:text="@string/div"
                android:textColor="@color/cloud_wisp"
